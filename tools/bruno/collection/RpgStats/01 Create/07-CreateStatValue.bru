meta {
  name: 07-CreateStatValue
  type: http
  seq: 7
}

post {
  url: {{host}}/{{basePath}}/{{statValuePath}}/CreateStatValue
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "level": 16,
    "value": 123,
    "containedBonusNum": 0,
    "containedBonusPercent": 0,
    "statId": 5,
    "characterId": 49
  }
}

vars:post-response {
  statValueId: res.body.data.id
}

assert {
  res.status: eq 201
}
